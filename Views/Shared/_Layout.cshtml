<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ulwazi Mapukata — Senior Software Engineer, Software Architect & Founder. 14 years of experience building enterprise payment platforms, multi-tenant SaaS and mission-critical fintech systems." />
    <meta name="keywords" content="Ulwazi Mapukata, Senior Software Engineer, Software Architect, .NET Developer, Fintech Engineer, ASP.NET Core, South Africa" />
    <meta name="author" content="Ulwazi Mapukata" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content="Ulwazi Mapukata — Senior Software Engineer & Architect" />
    <meta property="og:description" content="Engineering software that solves real problems. 14 years of experience building enterprise fintech, multi-tenant SaaS and mission-critical systems." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://umapukatadotcoza.onrender.com/" />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Ulwazi Mapukata — Senior Software Engineer & Architect" />
    <meta name="twitter:description" content="Engineering software that solves real problems. 14 years of experience building enterprise fintech, multi-tenant SaaS and mission-critical systems." />

    <title>@ViewData["Title"]</title>

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Person",
        "name": "Ulwazi Mapukata",
        "jobTitle": "Senior Software Engineer & Software Architect",
        "url": "https://umapukatadotcoza.onrender.com/",
        "sameAs": [
            "https://linkedin.com/in/ulwazim",
            "https://github.com/UlwaziM"
        ],
        "address": {
            "@@type": "PostalAddress",
            "addressLocality": "East London",
            "addressCountry": "ZA"
        },
        "worksFor": {
            "@@type": "Organization",
            "name": "Fakade Innovations (Pty) Ltd"
        },
        "knowsAbout": ["Software Engineering", "Software Architecture", "Fintech", ".NET", "ASP.NET Core", "Distributed Systems", "Multi-Tenant SaaS"]
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" type="image/x-icon" />
</head>
<body>
    <!-- Navigation -->
    <nav class="site-nav" role="navigation" aria-label="Main navigation">
        <div class="nav-inner">
            <a class="nav-brand" href="/" aria-label="Home">
                ulwazi<span class="brand-accent">.</span>dev
            </a>
            <ul class="nav-links" id="nav-links" role="menubar">
                <li role="none"><a role="menuitem" href="#about">About</a></li>
                <li role="none"><a role="menuitem" href="#experience">Experience</a></li>
                <li role="none"><a role="menuitem" href="#projects">Projects</a></li>
                <li role="none"><a role="menuitem" href="#skills">Expertise</a></li>
                <li role="none"><a role="menuitem" href="#certifications">Credentials</a></li>
                <li role="none"><a role="menuitem" href="#contact">Contact</a></li>
            </ul>
            <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-inner">
                <p class="footer-copy">&copy; @DateTime.Now.Year Ulwazi Mapukata. All rights reserved.</p>
                <ul class="footer-links">
                    <li><a href="https://linkedin.com/in/ulwazim" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                    <li><a href="https://github.com/UlwaziM" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                    <li><a href="mailto:ulwazim@gmail.com">Email</a></li>
                    <li><a asp-controller="Home" asp-action="PrivacyPolicy">Privacy</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
